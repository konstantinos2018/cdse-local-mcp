# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# NOT your Copernicus account username and password. This server only accepts OAuth
# client credentials, which can be revoked or expired on their own without touching
# your account.

# --- Required for downloads. Catalogue search works without them. -----------------
# Create at https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
#   User Settings -> OAuth clients -> Create
# The secret is displayed once, at creation. Copy it then.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Optional: S3 keys ------------------------------------------------------------
# Not used yet. They will speed up large transfers and enable windowed reads once
# selective download lands. Create at https://eodata-s3keysmanager.dataspace.copernicus.eu/
# CDSE_S3_ACCESS_KEY=
# CDSE_S3_SECRET_KEY=

# --- Optional: local behaviour ----------------------------------------------------
# Where downloads land. Defaults to ~/.cache/cdse-local-mcp
# CDSE_DOWNLOAD_DIR=/path/to/your/eo-data

# Transfer caps. Defaults are 5 GiB per call and 25 GiB per session.
# CDSE_MAX_CALL_BYTES=5368709120
# CDSE_MAX_SESSION_BYTES=26843545600

# Log verbosity on stderr: DEBUG, INFO, WARNING, ERROR
# CDSE_LOG_LEVEL=INFO
